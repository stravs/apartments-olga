---
import { pad } from '../lib/property';
interface Props { items: Array<{ label: string; value: string }> }
const { items } = Astro.props;
---
<div class="divide-y-2 divide-ink/10 border-y-2 border-ink/10">
  {items.map((item, index) => (
    <details class="group" open={index === 0}>
      <summary class="flex cursor-pointer items-baseline gap-4 py-5 text-lg font-semibold sm:text-xl">
        <span class="soft-serif w-8 shrink-0 text-base font-normal text-rose italic">{pad(index + 1)}</span>
        <span class="flex-1">{item.label}</span>
        <span class="relative size-5 shrink-0 self-center before:absolute before:inset-x-0 before:top-1/2 before:h-0.5 before:bg-current after:absolute after:inset-y-0 after:left-1/2 after:w-0.5 after:bg-current after:transition-transform group-open:after:scale-y-0" aria-hidden="true"></span>
      </summary>
      <p class="pb-6 pl-12 text-muted">{item.value}</p>
    </details>
  ))}
</div>
