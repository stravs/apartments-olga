---
import type { Property } from '../domain/property';
import type { Locale } from '../i18n';
import { useTranslations } from '../i18n';
import UnitCard from './UnitCard.astro';

interface Props { property: Property; locale: Locale; firstGalleryIndex: number }
const { property, locale, firstGalleryIndex } = Astro.props;
const t = useTranslations(locale);
const single = property.units.length === 1;
---
<section class="units-section" id="units">
  <div class="section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{t('chooseSpace')}</p>
        <h2>{single ? t('accommodation') : t('units')}</h2>
      </div>
      <p>{single ? t('option') : t('options', { count: property.units.length })}</p>
    </div>
    <div class="unit-list">
      {property.units.map((unit, index) => (
        <UnitCard
          {unit}
          galleryIndex={firstGalleryIndex + index}
          {locale}
        />
      ))}
    </div>
  </div>
</section>
