---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import UnitCard from '../components/UnitCard.astro';
import RatingStamp from '../components/RatingStamp.astro';
import Accordion from '../components/Accordion.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Lightbox from '../components/Lightbox.astro';
import AmenityIcon from '../components/AmenityIcon.astro';
import { findPhoto, fullAddress, getProperty, mapEmbedUrl, mapsUrl, summary, unitPath } from '../lib/property';
import { accommodation, lodgingBusiness } from '../lib/structured-data';
import { photoUrl } from '../lib/images';
import { formatMonth, localePath, strings, toLocale } from '../lib/i18n';

const locale = toLocale(Astro.currentLocale);
const t = strings(locale);
const property = await getProperty(locale);
const story = property.narrative;
const rating = property.bookingRating;
const testimonials = property.testimonials ?? [];
const [titleLine1, titleLine2] = story.heroTitle.split('\n');
const heroPhotos = story.heroPhotos.map((url) => findPhoto(property, url)).filter((photo) => photo !== undefined);
const housePhotoIndex = Math.max(0, property.photos.findIndex((photo) => photo.url === story.housePhoto));
const housePhoto = property.photos[housePhotoIndex];
const settingPhoto = findPhoto(property, story.settingPhoto);

const absolute = (path: string) => new URL(path, Astro.site).href;
const homeUrl = absolute(localePath(locale, '/'));
const propertyImages = await Promise.all(property.photos.map(async (photo) => absolute(await photoUrl(photo.url))));
const units = await Promise.all(property.units.map(async (unit) => accommodation(
  unit,
  absolute(localePath(locale, unitPath(unit.id))),
  unit.photos[0] ? [absolute(await photoUrl(unit.photos[0].url))] : [],
)));
const jsonLd = { '@context': 'https://schema.org', ...lodgingBusiness(property, homeUrl, propertyImages, units) };
const description = summary(`${property.name}, ${property.city}. ${property.description}`);

// Postcards in the hero: position, tilt and size for the house, the garden and a room.
const postcards = [
  'left-0 top-[6%] w-[78%] -rotate-3 z-10',
  'right-0 top-[30%] w-[40%] rotate-[5deg] z-20 [animation-delay:.18s]',
  'left-[9%] bottom-0 w-[35%] -rotate-2 z-30 [animation-delay:.32s]',
];
const sizes = ['(max-width: 1024px) 70vw, 460px', '(max-width: 1024px) 36vw, 240px', '(max-width: 1024px) 32vw, 210px'];
const tileColours = ['bg-teal text-white', 'bg-lemon', 'bg-rose text-white', 'bg-white', 'bg-leaf text-white'];
---
<Layout title={`${property.name} | ${property.city ?? t.accommodation}`} {description} image={propertyImages[0]} {jsonLd} {property}>
  <section class="px-3 sm:px-5" aria-labelledby="hero-title">
    <div class="relative overflow-hidden rounded-[2rem] bg-mustard">
      <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 py-12 sm:px-10 lg:grid-cols-[1.05fr_1fr] lg:gap-8 lg:py-20">
        <div>
          {story.heroEyebrow && <p class="text-sm font-bold tracking-[.2em] uppercase">{story.heroEyebrow}</p>}
          <h1 id="hero-title" class="soft-serif mt-5 text-[2.75rem] leading-[1.02] font-medium sm:text-6xl lg:text-7xl">{titleLine1}{titleLine2 && <><br /><em class="font-normal">{titleLine2}</em></>}</h1>
          <p class="mt-6 max-w-xl text-lg">{story.heroText}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#enquiry" class="btn-primary" data-enquire>{t.enquire}</a>
            <a href="#apartments" class="btn-outline">{t.seeApartments}</a>
          </div>
          {rating && (
            <a href="#reviews" class="group mt-10 inline-flex items-center gap-4">
              <RatingStamp {rating} {locale} class="shrink-0 -rotate-3 text-[1.35rem] transition-transform duration-500 ease-gentle group-hover:rotate-0" />
              <span class="link font-semibold">{t.reviewsCount(rating.count)}</span>
            </a>
          )}
        </div>
        <div class="relative order-first aspect-[1/.95] w-full max-w-xl justify-self-center lg:order-none lg:justify-self-end" aria-hidden="true">
          {heroPhotos.map((photo, index) => (
            <div class:list={['postcard absolute rounded-[3px] bg-[#FFFAEE] motion-safe:animate-drop', postcards[index]]}>
              <Photo {photo} sizes={sizes[index] ?? '30vw'} eager={index === 0} fallbackAlt="" class:list={['w-full object-cover', index === 0 ? 'aspect-[3/2]' : 'aspect-[3/4]']} />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <ul class="mx-auto mt-10 grid max-w-7xl grid-cols-2 gap-2 px-4 sm:grid-cols-3 sm:px-6 lg:grid-cols-5" aria-label={t.propertyHighlights}>
    {property.amenities.map((amenity, index) => (
      <li data-reveal style={`--reveal-delay:${index * 70}ms`} class:list={['flex flex-col justify-between gap-6 rounded-2xl p-5 font-semibold leading-snug', tileColours[index % tileColours.length], index === property.amenities.length - 1 && property.amenities.length % 2 === 1 && 'max-sm:col-span-2']}>
        <AmenityIcon name={amenity.icon} class="size-8" />
        {amenity.label}
      </li>
    ))}
  </ul>

  <section id="apartments" class="mt-20 scroll-mt-4 bg-cream py-24" aria-labelledby="apartments-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div data-reveal class="flex flex-wrap items-end justify-between gap-6">
        <h2 id="apartments-title" class="soft-serif text-5xl sm:text-6xl">{story.spacesTitle}</h2>
        {story.spacesText && <p class="max-w-md text-lg text-muted">{story.spacesText}</p>}
      </div>
      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-10">
        {property.units.map((unit, index) => <UnitCard {unit} {locale} delay={index * 100} />)}
      </div>

      <div data-reveal class="mt-20">
        <h3 class="soft-serif text-3xl">{t.compareTitle}</h3>
        <div class="mt-6 overflow-x-auto rounded-2xl bg-white p-2 sm:p-4" tabindex="0" role="region" aria-label={t.compareCaption}>
          <table class="w-full min-w-[34rem] text-left">
            <caption class="sr-only">{t.compareCaption}</caption>
            <thead>
              <tr class="border-b-2 border-ink">
                <td class="w-1/4"></td>
                {property.units.map((unit) => <th scope="col" class="soft-serif px-3 py-3 text-xl font-medium"><a href={localePath(locale, unitPath(unit.id))} class="link">{unit.name}</a></th>)}
              </tr>
            </thead>
            <tbody class="[&_tr]:border-b [&_tr]:border-dashed [&_tr]:border-ink/20 [&_tr:last-child]:border-0 [&_th]:px-3 [&_th]:py-3 [&_th]:text-sm [&_th]:font-semibold [&_th]:text-muted [&_td]:px-3 [&_td]:py-3">
              <tr><th scope="row">{t.size}</th>{property.units.map((unit) => <td>{unit.areaSquareMetres ? `${unit.areaSquareMetres} m²` : '—'}</td>)}</tr>
              <tr><th scope="row">{t.guests}</th>{property.units.map((unit) => <td>{unit.occupancyLabel ?? '—'}</td>)}</tr>
              <tr><th scope="row">{t.rooms}</th>{property.units.map((unit) => <td>{unit.bedrooms ? t.separateBedroom : t.openPlan}</td>)}</tr>
              <tr><th scope="row">{t.beds}</th>{property.units.map((unit) => <td>{unit.rooms.map((room) => room.beds).filter(Boolean).join(' + ') || '—'}</td>)}</tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-24 sm:px-6 lg:grid-cols-[.9fr_1.1fr] lg:gap-20" aria-labelledby="intro-title">
    {housePhoto && (
      <div data-reveal class="relative mx-auto w-full max-w-md">
        <div class="postcard absolute inset-0 translate-x-4 translate-y-3 rotate-[4deg] bg-cream" aria-hidden="true"></div>
        <button type="button" data-photo={housePhotoIndex} class="postcard group relative block w-full -rotate-2 cursor-zoom-in transition-transform duration-500 ease-gentle hover:rotate-0" aria-label={t.openHousePhotos}>
          <Photo photo={housePhoto} sizes="(max-width: 640px) 88vw, 440px" class="aspect-[3/4] w-full object-cover" />
          <span class="absolute right-5 bottom-5 rounded-full bg-white px-4 py-2 text-sm font-semibold shadow-lg">{t.photoCount(property.photos.length)}</span>
        </button>
      </div>
    )}
    <div>
      <h2 id="intro-title" data-reveal class="soft-serif text-4xl leading-[1.05] sm:text-5xl">{story.introTitle}</h2>
      <p data-reveal class="mt-5 max-w-2xl text-lg text-muted">{story.introText}</p>
      <ul class="mt-10 grid gap-x-6 gap-y-7 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">
        {story.highlights.map((item, index) => (
          <li data-reveal style={`--reveal-delay:${index * 90}ms`} class="border-t-2 border-ink pt-4">
            <strong class="soft-serif block text-2xl font-medium xl:text-xl">{item.title}</strong>
            <span class="mt-1 block text-muted">{item.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {rating && (
    <section id="reviews" class="scroll-mt-4 bg-deep text-paper" aria-labelledby="reviews-title">
      <div class="tiles h-3" aria-hidden="true"></div>
      <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6">
        <div class="flex flex-wrap items-end justify-between gap-10">
          <div data-reveal class="max-w-xl">
            <h2 id="reviews-title" class="soft-serif text-5xl sm:text-6xl">{t.reviewsTitle}</h2>
          </div>
          <a data-reveal href={rating.url} target="_blank" rel="noopener noreferrer" class="group inline-block">
            <RatingStamp {rating} {locale} class="-rotate-3 text-[1.5rem] transition-transform sm:text-[2.2rem] duration-700 ease-gentle group-hover:rotate-0" />
          </a>
        </div>
        {testimonials.length > 0 && (
          <div class="-mx-4 mt-14 flex snap-x snap-mandatory scroll-px-4 gap-5 overflow-x-auto px-4 pb-4 md:mx-0 md:grid md:grid-cols-3 md:overflow-visible md:px-0 md:pb-0" tabindex="0" role="region" aria-label={t.guestReviews}>
            {testimonials.map((review, index) => (
              <figure data-reveal style={`--reveal-delay:${index * 100}ms`} class="flex w-[85%] shrink-0 snap-start flex-col rounded-[3px] bg-paper p-7 text-ink md:w-auto">
                <span class="soft-serif text-6xl leading-[.6] text-mustard" aria-hidden="true">“</span>
                {/* Verbatim, in the guest's language (English). */}
                <blockquote lang="en" class="soft-serif mt-2 mb-6 text-xl leading-snug">{review.quote}</blockquote>
                <figcaption class="mt-auto flex flex-wrap justify-between gap-x-4 gap-y-1 border-t-2 border-dashed border-ink/15 pt-4 text-sm text-muted">
                  <span>{review.date && formatMonth(review.date, locale)}</span>
                  <a href={review.url} target="_blank" rel="noopener noreferrer" class="link">{review.source}</a>
                </figcaption>
              </figure>
            ))}
          </div>
        )}
        <a href={rating.url} target="_blank" rel="noopener noreferrer" class="btn-outline mt-12">{t.readAllReviews(rating.count)}</a>
      </div>
    </section>
  )}

  <section id="location" class="mx-auto grid max-w-7xl scroll-mt-4 gap-14 px-4 py-24 sm:px-6 lg:grid-cols-2 lg:gap-20" aria-labelledby="location-title">
    <div>
      <h2 id="location-title" data-reveal class="soft-serif text-4xl leading-[1.05] sm:text-5xl">{story.settingTitle}</h2>
      {story.settingText && <p data-reveal class="mt-5 text-lg text-muted">{story.settingText}</p>}
      <address data-reveal class="mt-5 not-italic"><a href={mapsUrl(property)} target="_blank" rel="noopener noreferrer" class="link font-semibold">{fullAddress(property)}</a></address>
      {property.nearby && (
        <>
          <h3 data-reveal class="mt-12 text-sm font-bold tracking-[.2em] uppercase">{t.nearbyTitle}</h3>
          <ul class="mt-4 space-y-3">
            {property.nearby.map((place, index) => (
              <li data-reveal style={`--reveal-delay:${index * 40}ms`} class="flex items-baseline gap-3">
                <span class:list={[place.major && 'soft-serif text-xl font-semibold']}>{place.name}</span>
                <span class="flex-1 border-b-2 border-dotted border-ink/25" aria-hidden="true"></span>
                <span class:list={['tabular-nums', place.major ? 'font-semibold' : 'text-muted']}>{place.distance}</span>
              </li>
            ))}
          </ul>
          <p class="mt-6 text-sm text-muted">{t.distancesNote}</p>
        </>
      )}
    </div>
    <div data-reveal style="--reveal-delay:150ms" class="relative flex flex-col gap-4 lg:pb-16">
      <iframe class="min-h-[26rem] w-full grow rounded-[1.75rem] border-0 bg-cream lg:min-h-0" data-src={mapEmbedUrl(property, locale)} title={t.mapTitle(property.name)} referrerpolicy="no-referrer-when-downgrade" allowfullscreen data-map></iframe>
      <a class="link self-start font-semibold lg:self-end" href={mapsUrl(property)} target="_blank" rel="noopener noreferrer">{t.directions}</a>
      {settingPhoto && (
        <div class="postcard absolute -bottom-2 -left-10 hidden w-44 -rotate-6 lg:block">
          <Photo photo={settingPhoto} sizes="176px" class="aspect-[3/4] w-full object-cover" />
        </div>
      )}
    </div>
  </section>
  <script>
    // Google Maps pulls ~15 requests: load the map only when it is about to scroll into view.
    const map = document.querySelector<HTMLIFrameElement>('[data-map]');
    if (map?.dataset.src) {
      const observer = new IntersectionObserver(([entry]) => {
        if (!entry?.isIntersecting) return;
        map.src = map.dataset.src ?? '';
        observer.disconnect();
      }, { rootMargin: '300px 0px' });
      observer.observe(map);
    }
  </script>

  <section id="good-to-know" class="scroll-mt-4 px-3 sm:px-5" aria-labelledby="good-to-know-title">
    <div class="rounded-[2rem] bg-cream">
      <div class="mx-auto grid max-w-7xl gap-12 px-5 py-16 sm:px-10 lg:grid-cols-[1fr_1.6fr] lg:py-20">
        <div>
          <h2 id="good-to-know-title" data-reveal class="soft-serif text-5xl sm:text-6xl">{t.practicalTitle}</h2>
          {(property.checkIn || property.checkOut) && (
            <dl data-reveal class="mt-10 grid max-w-sm grid-cols-2 gap-3">
              {property.checkIn && <div class="rounded-2xl bg-white p-5"><dt class="text-sm font-semibold text-muted">{t.checkIn}</dt><dd class="soft-serif mt-1 text-2xl">{property.checkIn}</dd></div>}
              {property.checkOut && <div class="rounded-2xl bg-white p-5"><dt class="text-sm font-semibold text-muted">{t.checkOut}</dt><dd class="soft-serif mt-1 text-2xl">{property.checkOut}</dd></div>}
            </dl>
          )}
        </div>
        <div data-reveal><Accordion items={story.practical} /></div>
      </div>
    </div>
  </section>

  <section id="enquiry" class="scroll-mt-4 px-4 pt-24 sm:px-6" aria-labelledby="enquiry-title">
    <div data-reveal class="mx-auto mb-10 max-w-5xl">
      <h2 id="enquiry-title" class="soft-serif text-4xl leading-tight sm:text-5xl">{t.enquiryLead[0]} <em>{t.enquiryLead[1]}</em></h2>
      {property.languages && <p class="mt-3 text-lg text-muted">{t.formText} {t.weSpeak(property.languages)}</p>}
    </div>
    <EnquiryForm {property} {locale} stampPhoto={heroPhotos[0]} />
  </section>

  <Lightbox photos={property.photos} title={property.name} {locale} />
</Layout>
